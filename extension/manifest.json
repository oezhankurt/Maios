{
  "manifest_version": 3,
  "name": "Maios - Marketplace Intelligence",
  "version": "1.0.0",
  "description": "Echtzeit-Produktdaten auf Amazon.de und Otto.de - direkt in der Sidebar",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.amazon.de/*",
    "https://www.otto.de/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.de/*"],
      "js": ["content-scripts/amazon.js"],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.otto.de/*"],
      "js": ["content-scripts/otto.js"],
      "css": ["styles/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "images/*"],
      "matches": ["https://www.amazon.de/*", "https://www.otto.de/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
