# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maios
DB_USER=postgres
DB_PASSWORD=postgres
# Railway / Vercel style single connection string (overrides the above if set)
DATABASE_URL=

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Amazon SP-API / Advertising API ────────────────────
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A1PA6795UKMFR9
AMAZON_REGION=eu

# ── Supermetrics (Amazon Daten-Sync) ──────────────────
SUPERMETRICS_API_KEY=
SUPERMETRICS_DS_USER=oezhan.kurt@point-rouge.de
SUPERMETRICS_MARKETPLACE=A1PA6795UKMFR9
ASIN_SYNC_USER_EMAIL=
ASIN_SYNC_MARKETPLACE_DOMAIN=amazon.de
ASIN_SYNC_ENABLED=true

# ── Scheduler ──────────────────────────────────────────
ENABLE_SCHEDULER=true

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=info
