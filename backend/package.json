{
  "name": "maios-backend",
  "version": "1.0.0",
  "description": "Maios - Amazon Seller Analytics & Automation Platform (backend API)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "node src/scripts/seed.js",
    "db:sync": "node src/scripts/syncDb.js",
    "db:backup": "node src/scripts/backup.js",
    "db:restore": "node src/scripts/restore.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "amazon",
    "seller",
    "analytics",
    "ppc",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-schedule": "^2.1.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "speakeasy": "^2.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
